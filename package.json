{
  "scripts": {
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:mobile && npm run check:dual-case && npm run check:app-dialog && npm run check:theme-tokens",
    "lint:backend": "eslint backend/src",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:mobile": "cd mobile && npm run lint",
    "check:dual-case": "node scripts/check-no-dual-case.mjs",
    "check:app-dialog": "node scripts/check-no-raw-eldialog.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "lint:fix": "npm run lint:fix:backend && npm run lint:fix:frontend && npm run lint:fix:mobile",
    "lint:fix:backend": "eslint backend/src --fix",
    "lint:fix:frontend": "cd frontend && npm run lint:fix",
    "lint:fix:mobile": "cd mobile && npm run lint:fix",
    "build:frontend": "cd frontend && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "format": "prettier --write \"backend/src/**/*.js\"",
    "format:check": "prettier --check \"backend/src/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.8.3"
  },
  "name": "erp",
  "version": "1.0.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarlynnLeo/Enterprise-ERP-System.git"
  },
