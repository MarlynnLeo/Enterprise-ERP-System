# ==================== Docker Compose 环境变量 ====================
# 复制此文件为 .env（与 docker-compose.yml 同级）并填入真实值
# ⚠️ .env 文件绝不可提交到 Git 仓库

# 数据库密码
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=erp_app
DB_NAME=mes
DB_PASSWORD=<YOUR_DB_PASSWORD_HERE>

# JWT 密钥（使用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成）
JWT_SECRET=<YOUR_JWT_SECRET_HERE>
JWT_REFRESH_SECRET=<YOUR_JWT_REFRESH_SECRET_HERE>
JWT_ISSUER=erp-system
JWT_AUDIENCE=erp-users
JWT_ALGORITHM=HS256

# CSRF 密钥
CSRF_SECRET=<YOUR_CSRF_SECRET_HERE>

DEFAULT_ADMIN_PASSWORD_HASH=
DEFAULT_ADMIN_PASSWORD=

# CORS 白名单，多个来源用英文逗号分隔
ALLOWED_ORIGINS=https://erp.yourdomain.com
PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Cookie transport for mixed internal HTTP + public HTTPS entry points
# `auto` supports both the internal HTTP address and the public HTTPS tunnel.
# The reverse proxy must send X-Forwarded-Proto and be listed in
# TRUST_PROXY_CIDRS.
COOKIE_SECURE=auto
COOKIE_SAME_SITE=lax
TRUST_PROXY_CIDRS=172.16.0.0/12,127.0.0.1

# MFA（密钥必须为 32 字节 Base64 或 64 位十六进制）
MFA_ENCRYPTION_KEY=<YOUR_MFA_ENCRYPTION_KEY_HERE>
MFA_REQUIRED_ROLE_CODES=admin,system_admin,finance_manager,hr_manager
MFA_TOTP_ISSUER=KACON ERP

# 统一 AI（用于预算分析和8D报告生成；远程供应商需显式允许）
AI_PROVIDER=nvidia
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=moonshotai/kimi-k2.6
AI_API_KEY=
NVIDIA_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
AI_ALLOW_REMOTE=false
AI_TIMEOUT_MS=300000
AI_MAX_TOKENS=16384
AI_TEMPERATURE=1
AI_TOP_P=1

# 本地 Ollama 兼容回退（旧部署可选）
OLLAMA_API_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=

# 高德地图天气 API Key（可选）
AMAP_API_KEY=

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_MS=5000
OPEN_METEO_TIMEZONE=Asia/Shanghai
OPEN_METEO_RETRIES=1

# 市场价格配置（可选）
METAL_PRICE_EXCHANGE_RATE_URL=https://api.frankfurter.app/latest?from=USD&to=CNY
METAL_PRICE_USD_CNY_FALLBACK=7.24
METAL_PRICE_REFRESH_CRON="0 */4 * * *"
METAL_PRICE_STARTUP_DELAY_MS=5000
METAL_PRICE_GOLD_REFERENCE_CNY_PER_OZ=34529.35
METAL_PRICE_PLATINUM_REFERENCE_CNY_PER_OZ=9020
METAL_PRICE_ALUMINUM_REFERENCE_CNY_PER_TON=19150
METAL_PRICE_COPPER_REFERENCE_CNY_PER_TON=69200
METAL_PRICE_GOLD_USD_PER_OZ=2050
METAL_PRICE_PLATINUM_USD_PER_OZ=950

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD_HERE>

# Ollama OCR 配置
OLLAMA_HOST=http://host.docker.internal:11434

# --- 安全配置 ---
ENABLE_RATE_LIMIT=true
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false
ACCOUNT_LOCK_ALLOW_MEMORY_FALLBACK=false
ENABLE_INPUT_SANITIZATION=true
ENABLE_CSRF=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# --- 日志 ---
LOG_LEVEL=INFO

# Database backup persistence, retention and encryption
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPTION_MODE=required
BACKUP_ENCRYPTION_KEY=<YOUR_BACKUP_ENCRYPTION_KEY_HERE>
