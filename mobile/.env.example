# 移动端环境变量配置示例
# 复制为 .env 后按部署环境调整。

# 浏览器请求默认走同源 /api，开发时由 Vite proxy 转发到后端。
VITE_APP_API_BASE_URL=/api

# Vite 开发代理目标，只影响本地 dev server。
VITE_API_TARGET=http://localhost:8080

# Vite 开发服务器配置。
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3001

# 应用信息。
VITE_APP_NAME=KACON-ERP移动端
VITE_APP_VERSION=1.0.0
VITE_APP_HOMEPAGE=

# 功能开关。
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=false
VITE_ENABLE_DEBUG=true
