{
  "name": "factory-management-backend",
  "version": "1.0.0",
  "description": "Backend for Factory Management System",
  "main": "src/index.js",
  "scripts": {
    "start": "node --expose-gc src/index.js",
    "start:prod": "NODE_ENV=production node --expose-gc src/index.js",
    "dev": "nodemon --watch src --watch migrations --watch knexfile.js --ignore logs/** --ignore uploads/** --ignore coverage/** --expose-gc src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "migrate": "npx knex migrate:latest",
    "migrate:rollback": "npx knex migrate:rollback",
    "migrate:status": "npx knex migrate:status",
    "migrations:verify": "node scripts/verify-migration-integrity.js",
    "migrations:manifest": "node scripts/verify-migration-integrity.js --write",
    "bootstrap:verify": "node scripts/verify-bootstrap-state.js",
    "seed": "npx knex seed:run",
    "restore:offline": "node scripts/restore-backup.js",
    "audit:closure": "node scripts/audit-business-closure.js",
    "audit:functional": "node scripts/audit-functional-coverage.js",
    "audit:finance": "node scripts/audit-finance-core.js",
    "test:finance-flow": "node scripts/test-finance-flow.js",
    "test:production-inventory-flow": "node scripts/test-production-inventory-flow.js",
    "replay:sales-outbound-dlq": "node scripts/replay-sales-outbound-dlq.js",
    "verify:coding-rules": "node scripts/verify-finance-coding-rules.js",
    "audit:finance-integrations": "node scripts/audit-finance-integrations.js",
    "audit:cash-settlement": "node scripts/audit-cash-settlement.js",
    "audit:invoice-generation": "node scripts/audit-invoice-generation.js",
    "audit:sales-integrations": "node scripts/audit-sales-integrations.js",
    "audit:quality-integrations": "node scripts/audit-quality-integrations.js",
    "audit:production-integrations": "node scripts/audit-production-integrations.js",
    "audit:cost": "node scripts/audit-cost-core.js",
    "repair:cash-settlement": "node scripts/repair-cash-settlement.js",
    "repair:invoice-generation": "node scripts/repair-invoice-generation.js",
    "repair:finance-integrations": "node scripts/repair-finance-integrations.js",
    "repair:quality-integrations": "node scripts/repair-quality-integrations.js",
    "repair:production-integrations": "node scripts/repair-production-integrations.js",
    "repair:sales-integrations": "node scripts/repair-sales-integrations.js",
    "repair:inventory-ledger-costs": "node scripts/repair-inventory-ledger-costs.js",
    "import:ng-sales-2026": "node scripts/import-ng-2026-sales-orders.js",
    "audit:status": "node scripts/audit-status-consistency.js",
    "audit:data": "node scripts/run-data-consistency-audit.js",
    "audit:inventory-types": "node scripts/audit-inventory-transaction-types.js",
    "audit:data-api": "node scripts/audit-data-api-uniformity.js",
    "audit:mobile-auth": "node scripts/audit-mobile-auth-security.js",
    "audit:workflow": "node scripts/audit-workflow-permission-closure.js",
    "audit:legacy": "node scripts/audit-legacy-code.js",
    "audit:production-readiness": "node scripts/audit-production-readiness.js",
    "audit:module-completeness": "node scripts/audit-module-completeness.js",
    "audit:all": "npm run audit:closure && npm run audit:functional && npm run audit:status && npm run audit:data && npm run audit:data-api && npm run audit:inventory-types && npm run audit:workflow && npm run audit:sales-integrations && npm run audit:quality-integrations && npm run audit:production-integrations && npm run audit:invoice-generation && npm run audit:finance && npm run audit:finance-integrations && npm run audit:cash-settlement && npm run audit:cost && npm run audit:mobile-auth && npm run audit:legacy && npm run audit:production-readiness && npm run audit:module-completeness && npm run verify:coding-rules",
    "perf:smoke": "node scripts/perf-smoke.js"
  },
  "keywords": [
    "factory",
    "management",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dayjs": "^1.11.21",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.8.2",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "js-yaml": "5.2.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.2.1"
    },
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
