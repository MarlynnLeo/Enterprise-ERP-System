# ==================================================
# ERP 后端环境变量配置模板
# 复制为 .env 并填入实际值
# ⚠️ 切勿将 .env 提交到版本控制
# ==================================================

# --- 数据库 ---
DB_HOST=192.168.1.251
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=mes

# --- JWT 认证 ---
# 使用 node -e "console.log(require('crypto').randomBytes(64).toString('base64'))" 生成
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
JWT_ISSUER=erp-system
JWT_AUDIENCE=erp-users
JWT_ALGORITHM=HS256

# --- 服务端口 ---
PORT=8080
NODE_ENV=development

# --- 天气服务（public-apis: Open-Meteo，无 Key；失败可降级 wttr.in）---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_TIMEZONE=Asia/Shanghai
OPEN_METEO_RETRIES=2
WEATHER_ENABLE_WTTR_FALLBACK=true

# --- 金属/汇率公开源（多源故障转移，见 PublicMarketDataService）---
# Frankfurter 请用 api.frankfurter.dev（.app 会 301）
METAL_PRICE_EXCHANGE_RATE_URL=https://api.frankfurter.dev/v1/latest?base=USD&symbols=CNY
METAL_PRICE_USD_CNY_FALLBACK=7.24
METAL_PRICE_ENABLE_YAHOO=true
METAL_PRICE_REFRESH_CRON=0 */4 * * *

# --- 安全配置 ---
# CSRF Secret: 使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
CSRF_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
DEFAULT_ADMIN_PASSWORD_HASH=
DEFAULT_ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_CIDRS=
ENABLE_RATE_LIMIT=true
# 生产环境默认要求 Redis；仅明确接受单实例内存限流风险时才设置为 true
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false
ACCOUNT_LOCK_ALLOW_MEMORY_FALLBACK=false
ENABLE_INPUT_SANITIZATION=true
ENABLE_CSRF=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# --- MFA ---
# 生产环境必须使用独立的 32 字节 Base64 或 64 位十六进制密钥
MFA_ENCRYPTION_KEY=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
MFA_REQUIRED_ROLE_CODES=admin,system_admin,finance_manager,hr_manager
MFA_TOTP_ISSUER=KACON ERP

# --- 备份加密 ---
BACKUP_ENCRYPTION_MODE=required
BACKUP_ENCRYPTION_KEY=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30

# --- 历史 SQL Server 诊断/迁移脚本（仅按需设置）---
LEGACY_DB_HOST=
LEGACY_DB_PORT=1433
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
LEGACY_DB_ENCRYPT=true
LEGACY_DB_TRUST_SERVER_CERTIFICATE=false

# --- AI 服务（可选）---
AI_PROVIDER=nvidia
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=qwen/qwen3.5-122b-a10b
AI_API_KEY=your_ai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
AI_TIMEOUT_MS=300000
AI_MAX_TOKENS=8192
AI_TEMPERATURE=1
AI_TOP_P=1

# --- 性能监控 ---
# 慢查询告警阈值（毫秒），超过此值的 SQL 查询会被记录为 WARN 日志
SLOW_QUERY_THRESHOLD=3000

# --- 日志 ---
# 日志级别: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
