# ==================================================
# ERP 后端环境变量配置模板
# 复制为 .env 并填入实际值
# ⚠️ 切勿将 .env 提交到版本控制
# ==================================================

# --- 数据库 ---
DB_HOST=192.168.1.251
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=mes

# --- JWT 认证 ---
# 使用 node -e "console.log(require('crypto').randomBytes(64).toString('base64'))" 生成
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES

# --- 服务端口 ---
PORT=8080
NODE_ENV=development

# --- 天气服务 ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- 安全配置 ---
# CSRF Secret: 使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
CSRF_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
ENABLE_RATE_LIMIT=true
ENABLE_INPUT_SANITIZATION=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# --- AI 服务（可选）---
AI_PROVIDER=nvidia
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=qwen/qwen3.5-122b-a10b
AI_API_KEY=your_ai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
AI_TIMEOUT_MS=300000
AI_MAX_TOKENS=8192
AI_TEMPERATURE=1
AI_TOP_P=1

# --- 性能监控 ---
# 慢查询告警阈值（毫秒），超过此值的 SQL 查询会被记录为 WARN 日志
SLOW_QUERY_THRESHOLD=3000

# --- 日志 ---
# 日志级别: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

