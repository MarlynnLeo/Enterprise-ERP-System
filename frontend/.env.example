# ERP PC 前端环境变量模板
# 复制为 .env.local 后按部署环境调整。

# 浏览器请求默认走同源 /api，开发时由 Vite proxy 转发到后端。
VITE_API_BASE_URL=/api

# 只有需要直接访问独立 API 域名时才设置，例如 https://api.example.com。
VITE_API_URL=
VITE_APP_API_BASE_URL=

# Vite 开发代理目标，只影响本地 dev server。
VITE_API_TARGET=http://localhost:8080
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3000

# Preview 白名单。
VITE_PREVIEW_ALLOWED_HOST=localhost
